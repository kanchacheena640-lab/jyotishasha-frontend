# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.next-u6b-build/
/.next-u6b-dev/

# Local Saved Audience verification output (scripts remain reviewable)
/.u6b-*

# N6 Notifications History/Monitor visual QA screenshots (scripts remain reviewable)
/.n6-visual/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI working files (overwritten by Gemini CLI — not production content)
.ai/
